APP_NAME="Attendance"
APP_ENV=production
APP_KEY=
APP_DEBUG=false

# --- Subdirectory hosting -------------------------------------------------
# When the application is served from a subdirectory, both values must point
# at that subdirectory. Example for https://app.euro-mega.com/attendance :
APP_URL=https://app.euro-mega.com/attendance
ASSET_URL=/attendance
#
# Local development (php artisan serve) would instead be:
# APP_URL=http://localhost:8000
# ASSET_URL=
# --------------------------------------------------------------------------

# Timezone used for "today", daily grouping and every displayed time.
# Attendance is stored with the authoritative server timestamp and shown here.
APP_TIMEZONE=Africa/Lagos

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database (MySQL / MariaDB) -------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=attendance
DB_USERNAME=root
DB_PASSWORD=
# --------------------------------------------------------------------------

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Reverse geocoding (OpenStreetMap Nominatim) --------------------------
# A descriptive User-Agent is required by the Nominatim usage policy.
NOMINATIM_ENDPOINT=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT="Attendance App (app.euro-mega.com)"
NOMINATIM_EMAIL=
# --------------------------------------------------------------------------

VITE_APP_NAME="${APP_NAME}"
