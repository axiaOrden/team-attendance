# ---------------------------------------------------------------------------
# Subdirectory hosting (XAMPP / Apache)
# ---------------------------------------------------------------------------
# Drop this whole project inside "htdocs/attendance" (or any subdirectory) and
# browse to https://app.euro-mega.com/attendance - every request is forwarded
# into the public/ directory, which keeps the application code outside of the
# web root while the application itself is served from the subdirectory.
#
# Remember to point APP_URL and ASSET_URL at the subdirectory as well.
# ---------------------------------------------------------------------------

<IfModule mod_negotiation.c>
    Options -MultiViews -Indexes
</IfModule>

DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Send everything into public/ (front controller, assets and build output).
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<IfModule !mod_rewrite.c>
    # Without mod_rewrite the application is still reachable through
    # https://app.euro-mega.com/attendance/public/
    RedirectMatch 302 "^/attendance/?$" "/attendance/public/"
</IfModule>
